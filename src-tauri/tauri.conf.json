{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alos",
  "version": "0.2.1",
  "identifier": "com.alos.todoapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alos",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZBNTExQkNDNDY4M0RFMkIKUldRcjNvTkd6QnRSYXF6K244VllsUFcwemVZei9tQnRSODBYb052U0FuT2htbitQRmZzK2JqVUkK",
      "endpoints": [
        "https://github.com/CanKarpat/alos-todo-app/releases/latest/download/latest.json"
      ]
    }
  }
}